{
    "name": "@xsecuro/core",
    "version": "1.1.0",
    "description": "Core library for xsecuro project",
    "keywords": [
        "password",
        "generator",
        "cryptography",
        "crypto"
    ],
    "homepage": "https://github.com/xsecuro/core#readme",
    "bugs": {
        "url": "https://github.com/xsecuro/core/issues",
        "email": "xlebpushek@gmail.com"
    },
    "license": "MIT",
    "author": {
        "name": "Xlebp Rjanoi",
        "email": "xlebpushek@gmail.com",
        "url": "https://github.com/xsecuro"
    },
    "funding": {
        "type": "github",
        "url": "https://github.com/sponsors/xsecuro"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/xsecuro/core.git"
    },
    "publishConfig": {
        "access": "public"
    },
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs"
        },
        "./types": {
            "types": "./dist/types/index.d.ts",
            "import": "./dist/types/index.mjs",
            "require": "./dist/types/index.cjs"
        },
        "./errors": {
            "types": "./dist/errors/index.d.ts",
            "import": "./dist/errors/index.mjs",
            "require": "./dist/errors/index.cjs"
        },
        "./generator": {
            "types": "./dist/generator/index.d.ts",
            "import": "./dist/generator/index.mjs",
            "require": "./dist/generator/index.cjs"
        }
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "format:check": "prettier --check src/**/*.ts",
        "format:fix": "prettier --write src/**/*.ts",
        "typedoc": "typedoc src",
        "clean": "rimraf dist",
        "build": "unbuild",
        "release": "semantic-release"
    },
    "devDependencies": {
        "@semantic-release/changelog": "^6.0.3",
        "@semantic-release/git": "^10.0.1",
        "@semantic-release/github": "^11.0.6",
        "@semantic-release/npm": "^12.0.2",
        "@types/node": "^24.12.0",
        "conventional-changelog-conventionalcommits": "^9.3.0",
        "prettier": "^3.8.1",
        "rimraf": "^6.1.3",
        "rollup": "^4.59.0",
        "semantic-release": "^24.2.9",
        "svgo": "^4.0.1",
        "typedoc": "^0.28.17",
        "typescript": "^5.9.3",
        "unbuild": "^3.6.1"
    },
    "overrides": {
        "rollup": "^4.59.0",
        "svgo": "^4.0.1",
        "tar": "^7.5.4"
    },
    "trustedDependencies": [
        "unrs-resolver"
    ]
}
